# Copy this file to .env and fill in real values. Never commit .env to GitHub.
PORT=3000
# Local PostgreSQL:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pill_reminder
# Or Neon (online): paste the connection string from Neon → Connect, e.g.
# DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Make these long and random, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of web origins allowed to call the API (the admin panel).
CORS_ORIGINS=http://localhost:5173

# Optional: comma-separated Overpass servers for the Nearby map (first = preferred).
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
